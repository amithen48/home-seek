# ---------------------------------------------------------------------------
# home-seek - copy this to `.env` and fill in real values.
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database (default is SQLite in the repo root)
DATABASE_URL=sqlite+aiosqlite:///./home_seek.db

# Telegram - create a bot via @BotFather and get a chat id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scraping behavior
REQUEST_TIMEOUT_SECONDS=20
MIN_DELAY_BETWEEN_REQUESTS_SECONDS=30
MAX_LISTINGS_PER_RUN_PER_AREA=50

# Scheduler
SCRAPE_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true

# API / Web dashboard
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Feature flags
#  - false (default): only the StubScraper runs. Safe in dev / when the
#    network policy blocks Israeli targets.
#  - true: register the real Yad2Scraper as well. Requires outbound access
#    to gw.yad2.co.il.
ENABLE_LIVE_SCRAPERS=false
